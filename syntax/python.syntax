# Python syntax rules for pvim.

filetype = python

ext = .py

# Match scripts that start with "#!/usr/bin/env python3" etc.
shebang = python

single_comment = #

flags = numbers strings

keywords = and as assert async await break class continue def del elif else except
keywords = finally for from global if import in is lambda nonlocal not or pass
keywords = raise return try while with yield

types = int float bool str list dict set tuple bytes complex